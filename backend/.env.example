# ─────────────────────────────────────────────────────────────────
# AquaWatch Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Database (provided by Member 4 / DevOps) ─────────────────────
# Supabase connection string (with pgBouncer for serverless)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection for migrations
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ── Auth ─────────────────────────────────────────────────────────
JWT_SECRET="replace-with-a-long-random-string"

# ── AI microservice (Member 3 / DevOps provides URL) ─────────────
AI_SERVICE_URL="http://localhost:8000"

# ── Blynk Cloud (provided by Member 4 / DevOps) ──────────────────
BLYNK_AUTH_TOKEN=""          # Blynk device auth token (leave blank to disable polling)
BLYNK_RELAY_PIN="V0"        # Virtual pin wired to the relay on the ESP32-S3

# ── Job intervals ─────────────────────────────────────────────────
BLYNK_POLL_INTERVAL_MS=10000     # How often to poll Blynk (ms). Default: 10 000 = 10 s
WEATHER_FETCH_INTERVAL_MS=1800000 # How often to fetch weather (ms). Default: 1 800 000 = 30 min
AI_CYCLE_INTERVAL_MS=60000        # How often to run AI predictions (ms). Default: 60 000 = 1 min

# ── Hardware / tank dimensions ────────────────────────────────────
TANK_HEIGHT_CM=100   # Height of the tank in cm (for JSN-SR04T distance → level conversion)

# ── Server ───────────────────────────────────────────────────────
PORT=4000
# Comma-separated list of allowed CORS origins (frontend URLs)
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# ── Weather (optional — only needed if you switch from Open-Meteo to OpenWeatherMap) ──
# OPENWEATHER_API_KEY=""

# ── Zone coordinates (optional — overrides defaults in weatherFetcher.js) ─────────
# JSON map of zone name → [lat, lon]. Must match zone names in the DB exactly.
# ZONE_COORDS_JSON='{"Ahmedabad North":[23.0225,72.5714],"Surat West":[21.1702,72.8311]}'
