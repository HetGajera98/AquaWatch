// This is your Prisma schema file for AquaWatch
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum SensorType {
  TANK_LEVEL
  FLOW_RATE
  FLOAT_SWITCH
}

enum StressLevel {
  LOW
  MEDIUM
  HIGH
}

enum AlertType {
  SHORTAGE
  LEAK
  PUMP
}

enum PumpActionSource {
  AUTO
  MANUAL
}

enum PumpState {
  ON
  OFF
}

// ─────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("users")
}

model Zone {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  tanks    Tank[]
  weather  WeatherReading[]
  alerts   Alert[]

  @@map("zones")
}

model Tank {
  id         String   @id @default(uuid())
  zoneId     String
  name       String
  capacityL  Float
  createdAt  DateTime @default(now())

  zone         Zone          @relation(fields: [zoneId], references: [id])
  sensors      Sensor[]
  pumpActions  PumpAction[]

  @@map("tanks")
}

model Sensor {
  id              String     @id @default(uuid())
  tankId          String
  type            SensorType
  blynkVirtualPin String
  createdAt       DateTime   @default(now())

  tank     Tank             @relation(fields: [tankId], references: [id])
  readings SensorReading[]
  alerts   Alert[]

  @@map("sensors")
}

model SensorReading {
  id         String   @id @default(uuid())
  sensorId   String
  value      Float
  unit       String
  recordedAt DateTime @default(now())

  sensor Sensor @relation(fields: [sensorId], references: [id])

  @@index([sensorId, recordedAt])
  @@map("sensor_readings")
}

model WeatherReading {
  id           String   @id @default(uuid())
  zoneId       String
  temperatureC Float
  rainfallMm   Float
  forecastFor  DateTime
  fetchedAt    DateTime @default(now())

  zone Zone @relation(fields: [zoneId], references: [id])

  @@index([zoneId, forecastFor])
  @@map("weather_readings")
}

model Alert {
  id         String      @id @default(uuid())
  zoneId     String
  sensorId   String?
  type       AlertType
  severity   StressLevel
  message    String
  resolved   Boolean     @default(false)
  createdAt  DateTime    @default(now())

  zone   Zone    @relation(fields: [zoneId], references: [id])
  sensor Sensor? @relation(fields: [sensorId], references: [id])

  @@index([zoneId, createdAt])
  @@map("alerts")
}

model PumpAction {
  id          String           @id @default(uuid())
  tankId      String
  state       PumpState
  reason      String
  source      PumpActionSource
  triggeredAt DateTime         @default(now())

  tank Tank @relation(fields: [tankId], references: [id])

  @@index([tankId, triggeredAt])
  @@map("pump_actions")
}
