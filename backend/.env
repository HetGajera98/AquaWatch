# V0 = Water Level (%)          — tank fill percentage
# V1 = Water Distance (cm)      — JSN-SR04T ultrasonic raw distance
# V2 = Flow Rate (L/min)        — YF-S201 flow sensor
# V3 = Pump Control (0=OFF,1=ON) — relay output
# V4 = Total Water (L)          — cumulative litres counter
BLYNK_RELAY_PIN="V3"

