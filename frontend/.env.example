# =============================================================
# AquaWatch Frontend — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================

# Backend API base URL (Express server, no trailing slash)
# Local dev: http://localhost:4000
# Deployed:  https://your-backend-domain.com
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# AI service URL — used by the Next.js /api/predict proxy route
# Local dev: http://localhost:8000
# Deployed:  https://your-ai-service.com
AI_SERVICE_URL=http://localhost:8000
